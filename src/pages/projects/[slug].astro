---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ProjectDetail } from '../../components/ProjectDetail';
import { hasDetailPage } from '../../lib/projects';
import { content } from '../../content/load';
import { resolveImage } from '../../lib/images';
import { toOgImage } from '../../lib/ogImage';
import { renderMarkdown } from '../../lib/markdown';

export const getStaticPaths = (() =>
  content.projects.filter(hasDetailPage).map((project) => ({ params: { slug: project.id }, props: { project } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
// Detail width 1200; the same optimized image is the absolute og:image.
const image = await resolveImage(project.image, { width: 1200 });
---
<BaseLayout
  title={`${project.title} — ${content.profile.name}`}
  description={project.summary}
  path={`/projects/${project.id}/`}
  ogImage={toOgImage(image)}
  ogImageAlt={image ? project.imageAlt || project.title : undefined}
  type="article"
>
  <ProjectDetail project={project} image={image} html={renderMarkdown(project.description)} />
</BaseLayout>
